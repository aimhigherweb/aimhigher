---
import Icon from '../../../../../lib/parts/icon/index.astro';
import * as styles from './social.module.scss';

const { items } = Astro.props;
---

<nav aria-label="social-nav" class={styles.nav}>
	<ul>
		{items.map(({ label, icon, link }) => (
			<li>
				<a target="_blank" rel="noopener" href={link} class={styles.item}>
					<Icon icon={icon} />
					<span class="sr-only">{label}</span>
				</a>
			</li>
		))}
	</ul>
</nav>
