---
import ContactForm from '../components/parts/form/ContactForm.astro';
import Flower from '../img/illustrations/flower_2.svg';
import Paw from '../img/illustrations/paw.svg';
import Squiggle from '../img/illustrations/squiggle.svg';
import social from '../img/social/contact.png';
import Layout from '../layouts/Layout.astro';
import * as styles from '../styles/pages/contact.module.scss';
import { getContent } from '../utils/content.js';

const { title, meta, html } = await getContent(`contact/index`);
---

<Layout meta={{ ...meta, image: social.src }}>
	<div class={styles.content}>
		<Squiggle class={styles.squiggle} />
		<h1>{title}</h1>
		<div class={styles.blurb} set:html={html} />
		<ContactForm name="contact" />
		<Flower class={styles.flower} />
		<Paw class={styles.paw} />
	</div>
</Layout>
