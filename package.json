{
	"name": "aimhigher",
	"version": "8.0.0",
	"description": "Website for AimHigher Web",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aimhigherweb/aimhigher.git"
	},
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev --config config/astro.config.mjs",
		"build": "astro build --config config/astro.config.mjs",
		"preview": "astro preview --config config/astro.config.mjs",
		"lint": "eslint -c ./config/eslint.config.mjs --fix .",
		"lint:ci": "eslint -c ./config/eslint.config.mjs .",
		"lint:html": "html-validate --config config/htmlvalidate.json \"dist/**/*.html\"",
		"test:a11y": "pa11y --config config/pa11y.config.json $URL",
		"test": "playwright test -c config/playwright.config.js",
		"test:report": "playwright show-report tests/report",
		"contrast:gradient": "node scripts/gradient-contrast.js",
		"test:headings": "node scripts/blog-headings.js"
	},
	"author": "Amy Kapernick <amy@aimhigherweb.design> (https://aimhigherweb.design)",
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.10",
		"@astrojs/sitemap": "^3.7.5",
		"astro": "^7.4.12",
		"date-fns": "^4.4.0",
		"markdown-it": "^15.0.3",
		"markdown-it-image-figures": "^2.1.1",
		"prismjs": "^1.30.0",
		"sass": "^1.108.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@stylistic/eslint-plugin": "^6.0.1",
		"eslint": "^10.15.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-import-x": "^4.18.1",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"globals": "^17.14.0",
		"html-validate": "^11.21.1",
		"netlify-cli": "^27.20.0",
		"pa11y": "^10.0.0",
		"pngjs": "^7.0.0"
	}
}
